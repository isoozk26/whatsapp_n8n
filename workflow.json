        "jsCode": "const input = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\n\nif (staticData._batches && input.senderNumber) {\n  delete staticData._batches[input.senderNumber];\n}\n\nreturn [{ json: input }];"
      },
